{
  "name": "meowglitch",
  "productName": "MEOW GLITCH",
  "version": "1.0.0",
  "description": "Layered glitch art editor with per-layer WebGL effects",
  "author": "Jade (Rose) Rowland",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --arm64",
    "install-app": "npm run dist && rm -rf \"/Applications/MEOW GLITCH.app\" && ditto \"dist/mac-arm64/MEOW GLITCH.app\" \"/Applications/MEOW GLITCH.app\""
  },
  "build": {
    "appId": "com.daslyfe.meowglitch",
    "productName": "MEOW GLITCH",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "app.js",
      "browser.js",
      "text.js",
      "app.css",
      "css/**",
      "fonts/**",
      "assets/icon.png",
      "electron/**"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "assets/icon.png",
      "target": [
        "dir"
      ]
    }
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  }
}
